# Copy to .env.local (Next.js) — Prisma CLI also reads .env, so keeping a
# plain .env with DATABASE_URL is easiest for local development.

# SQLite for local development; swap for a PostgreSQL URL in production, e.g.
# postgresql://user:password@localhost:5432/kdp_studio
DATABASE_URL="file:./dev.db"

# AI providers (used from Phase 2 onwards). Server-side only — never exposed
# to the browser.
OPENAI_API_KEY=
TEXT_PROVIDER=openai
IMAGE_PROVIDER=openai

# Image/file storage backend: local | s3 | r2 | supabase (local for now)
STORAGE_PROVIDER=local
