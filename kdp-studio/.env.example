# Copy to .env (Prisma CLI and Next.js both read it) for local development.

# --- Database ---------------------------------------------------------------
# Local development (SQLite, zero setup):
DATABASE_URL="file:./dev.db"
# Hosted deployment (PostgreSQL, e.g. Neon/Supabase/Vercel Postgres):
# DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# (Deployments also switch the Prisma provider — see DEPLOY.md; the
#  `vercel-build` script does it automatically on Vercel.)

# --- AI providers (server-side only, never exposed to the browser) ----------
# Text planning (Phase 2+). Without a key the app uses a built-in sample
# generator so the workflow still works end-to-end.
OPENAI_API_KEY=
# openai | mock — leave unset to auto-select (openai when a key is present)
TEXT_PROVIDER=
# Optional model override (default: gpt-4o-mini)
OPENAI_TEXT_MODEL=

# Image generation (Phase 3+)
IMAGE_PROVIDER=

# --- Storage ----------------------------------------------------------------
# local | vercel-blob | r2 — leave empty to auto-select: Cloudflare R2 when
# its five R2_* vars are set, else Vercel Blob when its token is set, else
# local disk.
STORAGE_PROVIDER=local

# Image model options (OpenAI): gpt-image-1 (default) or dall-e-3
OPENAI_IMAGE_MODEL=
# gpt-image-1: low | medium (default) | high — dall-e-3: standard | hd
OPENAI_IMAGE_QUALITY=

# Hosted image storage (Vercel Blob) — created automatically when a Blob
# store is connected to the Vercel project; leave empty for local disk.
BLOB_READ_WRITE_TOKEN=

# Cloudflare R2 storage (10GB free, no egress fees). All five must be set;
# takes precedence over Vercel Blob when configured. See DEPLOY.md.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
