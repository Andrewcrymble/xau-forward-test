// KDP Colouring Book Studio — database schema.
//
// Uses SQLite for local development. The schema deliberately avoids
// SQLite-only or Postgres-only features (enums, Json columns) so switching
// the datasource provider to "postgresql" requires no model changes:
//   - status fields are strings, validated by Zod + TypeScript unions in src/lib/types.ts
//   - structured settings are stored as JSON-encoded strings

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  createdAt DateTime  @default(now())
  projects  Project[]
}

model Project {
  id     String  @id @default(cuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Book metadata
  name        String
  title       String
  subtitle    String?
  author      String?
  niche       String  // main niche, e.g. "Christian", "Dinosaurs", "European Cities"
  subNiche    String? // e.g. "Encouraging Bible Verses", "Cute Baby Dinosaurs"
  // Specific theme / positioning angle — free description of what makes THIS
  // book different from others in the same niche.
  specificAngle String?
  description String?

  // Multi-select emotional tones — JSON-encoded string[] of EmotionalTone ids
  emotionalTones String @default("[]")
  // Recurring imagery the artwork should draw on, free text
  artworkTheme   String?

  // Persistent creative direction — JSON-encoded BookConcept (creative brief
  // + Book Style Profile) passed into every image-generation prompt.
  bookConcept String?

  // ColourJoy interior style engine: "auto" | "bold_easy" | "cozy_cute"
  // | "classic" | "detailed_adult" (auto derives from audience/complexity)
  colourjoyStyle String @default("auto")
  // "standard" | "colour_by_numbers" | "mixed"
  colouringMode String @default("standard")
  // JSON-encoded CbnSettings: counts/difficulty/colours/palette/key placement
  cbnSettings   String @default("{}")
  // JSON-encoded BibleSettings when the niche involves scripture
  bibleSettings String @default("{}")

  // Audience / format
  targetAudience String // TargetAudience id, e.g. "ages_4_8" | "adults" | "custom"
  customAudience String?
  trimSize       String @default("8.5x11") // TrimSizeId from src/lib/config/kdp-spec.ts
  numberOfDesigns Int

  // Style
  style                String // StyleId, e.g. "clean_childrens" | "custom"
  customStyle          String?
  complexity           String // ComplexityId, e.g. "very_simple" .. "highly_detailed"
  complexityOverridden Boolean @default(false)

  // Interior options — JSON-encoded InteriorOptions (src/lib/types.ts)
  interiorOptions String @default("{}")

  // Amazon listing content — JSON-encoded ListingContent (src/lib/types.ts)
  listing   String?

  status    String   @default("setup") // ProjectStatus
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pages          ColouringPage[]
  cover          Cover?
  exports        Export[]
  generationLogs GenerationLog[]
}

model ColouringPage {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  pageNumber Int
  title      String
  concept    String
  // "standard" | "colour_by_numbers"
  pageType   String  @default("standard")
  // Verse or quote text intentionally included in the artwork (with source
  // reference), plus a verification flag — never invented scripture.
  pageText   String?
  // JSON-encoded CbnPageData: palette, region assignments, difficulty,
  // numbered/reference image keys, validation findings.
  cbnData    String?
  // Completed coloured reference image (colour-by-numbers answer version)
  completedReference String?
  prompt     String  @default("")
  // True once the user hand-edits the prompt; auto-rebuilds then stop.
  promptEdited Boolean @default(false)

  // Storage keys resolved via the storage abstraction (not raw binary data)
  originalImage  String?
  processedImage String?
  // User-uploaded reference photo the AI must faithfully redraw as line art
  // (e.g. a real mural photographed for a murals colouring book).
  referenceImage String?

  generationStatus   String @default("planned") // GenerationStatus
  approvalStatus     String @default("pending") // ApprovalStatus
  validationStatus   String @default("not_checked") // ValidationStatus
  // Human-readable list of automatic quality-check findings, newline-separated
  validationIssues   String?
  generationAttempts Int    @default(0)
  notes              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions ImageVersion[]

  @@index([projectId, pageNumber])
}

// Every (re)generation keeps its result — regeneration never overwrites an
// approved image. The page's originalImage/processedImage point at the
// currently selected version.
model ImageVersion {
  id     String        @id @default(cuid())
  pageId String
  page   ColouringPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  versionNumber  Int
  originalImage  String
  processedImage String?
  createdAt      DateTime @default(now())

  @@index([pageId, versionNumber])
}

model Cover {
  id        String  @id @default(cuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  artwork       String?
  title         String?
  subtitle      String?
  author        String?
  backCoverText String?
  spineText     String?
  settings      String  @default("{}") // JSON-encoded cover editor settings
}

model Export {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  type      String // "interior_pdf" | "cover_pdf" | "kdp_package" | ...
  filePath  String
  createdAt DateTime @default(now())
}

// A saved niche concept from the Find Me a Niche engine. All scores are AI
// concept analysis — NEVER verified market data; genuine research results,
// when added later, live in the separate marketData column so the two are
// never mixed.
model NicheIdea {
  id     String  @id @default(cuid())
  userId String?

  broadTopic String // what the user typed, e.g. "Christian", "Belfast"
  name       String // final niche name
  // JSON-encoded string[] — the niche tree path, broad → specific
  path       String @default("[]")

  audience     String?
  concept      String? // book concept summary
  artwork      String? // suggested artwork direction
  bookType     String? // "standard" | "colour_by_numbers" | "mixed" | ...
  pageCount    Int?
  complexity   String? // recommended ComplexityId
  difficulty   String? // how hard the book is to produce well
  positioning  String? // who/what/why/differentiation statement
  giftPotential   String?
  seriesPotential String?

  // JSON-encoded NicheScores (1-10 concept scores, AI opinion only)
  scores String @default("{}")
  // JSON-encoded series suggestion { name, books[] } when generated
  seriesIdeas String?
  // Reserved for FUTURE verified research (Amazon results, prices, reviews…)
  // — kept strictly separate from the AI concept scores above.
  marketData String?

  // "new" | "favourite" | "considering" | "building" | "book_created" | "rejected"
  status String @default("new")
  // Lineage for GO DEEPER / COMBINE — the parent idea this was derived from
  parentId String?
  // Set when BUILD THIS BOOK creates a project from this idea
  linkedProjectId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([broadTopic])
  @@index([status])
}

// Cost / usage tracking for every AI request (text or image).
model GenerationLog {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  kind          String // "book_plan" | "page_image" | "cover_image" | "listing" | ...
  provider      String?
  model         String?
  estimatedCost Float?
  actualCost    Float?
  tokensUsed    Int?
  imageCount    Int?
  message       String?
  createdAt     DateTime @default(now())
}
